{
  "source": "Microsoft Defender XDR (Graph security alerts)",
  "version": "2026-09-17",
  "description": "Alert titles of the source mapped to the framework's alert types. Rules are evaluated in order: a detector id match wins over any title match, then the first rule with a matching title pattern. Detector ids are tenant-observable GUIDs: add them under detector_ids as they are seen, they make the mapping exact where a title is ambiguous or localized. An alert no rule matches is reported as unmapped by scripts/alert_types.py.",
  "rules": [
    {
      "alert_type": "Ransomware mass-encryption",
      "domain": "Endpoint",
      "detector_ids": [],
      "title_patterns": [
        "ransomware behaviou?r",
        "ransomware.*(detected|activity)",
        "file was encrypted",
        "mass (file )?encryption"
      ]
    },
    {
      "alert_type": "Mass file destruction / disk wipe",
      "domain": "Endpoint",
      "detector_ids": [],
      "title_patterns": [
        "shadow cop(y|ies).*(delet|tamper)",
        "file backups? (were|was) deleted",
        "inhibit system recovery",
        "disk wip",
        "mass file delet"
      ]
    },
    {
      "alert_type": "Credential dumping",
      "domain": "Endpoint",
      "detector_ids": [],
      "title_patterns": [
        "credential dumping",
        "credential memory read",
        "lsass",
        "credential theft",
        "sam (database|registry) .*(dump|access)",
        "mimikatz"
      ]
    },
    {
      "alert_type": "Security-tool / AMSI tampering",
      "domain": "Endpoint",
      "detector_ids": [],
      "title_patterns": [
        "tamper",
        "attempt to turn off .*(antivirus|protection)",
        "amsi",
        "(antivirus|real-time protection|security (tool|software)) .*(disabled|turned off|stopped)",
        "security log was cleared"
      ]
    },
    {
      "alert_type": "Persistence mechanism created",
      "domain": "Endpoint",
      "detector_ids": [],
      "title_patterns": [
        "scheduled task",
        "suspicious service (registered|creat|install)",
        "(registry )?run key",
        "autostart",
        "anomaly detected in asep",
        "persistence"
      ]
    },
    {
      "alert_type": "Suspicious script / interpreter execution",
      "domain": "Endpoint",
      "detector_ids": [],
      "title_patterns": [
        "powershell",
        "suspicious (script|command ?line|wscript|cscript|mshta|rundll32|regsvr32)",
        "living[- ]off[- ]the[- ]land",
        "encoded command",
        "remote (shell|command|powershell)",
        "suspicious remote activity"
      ]
    },
    {
      "alert_type": "Trusted software / updater anomalous behaviour",
      "domain": "Endpoint",
      "detector_ids": [],
      "title_patterns": [
        "dll (side|search)[- ]?(load|order)",
        "signed (binary|executable).*(unusual|suspicious)",
        "updater .*(anomal|suspicious)"
      ]
    },
    {
      "alert_type": "Ingress tool transfer to host",
      "domain": "Endpoint",
      "detector_ids": [],
      "title_patterns": [
        "tool transfer",
        "(hack|attack) ?tool .*(download|drop|written)",
        "suspicious (file )?download",
        "certutil"
      ]
    },
    {
      "alert_type": "Malware / loader execution",
      "domain": "Endpoint",
      "detector_ids": [],
      "title_patterns": [
        "malware (was )?(detected|prevented|blocked|found)",
        "an active .* (malware|hacktool|backdoor|trojan)",
        "trojan",
        "backdoor",
        "hacktool",
        "loader",
        "suspicious (file|binary|executable|process)",
        "process injection",
        "unwanted software"
      ]
    },
    {
      "alert_type": "Impossible-travel / anomalous sign-in",
      "domain": "Identity",
      "detector_ids": [],
      "title_patterns": [
        "impossible travel",
        "atypical travel",
        "unfamiliar sign-?in",
        "anonymous ip",
        "anomalous (sign-?in|token)",
        "malicious ip address",
        "risky sign-?in"
      ]
    },
    {
      "alert_type": "Brute force / password spray",
      "domain": "Identity",
      "detector_ids": [],
      "title_patterns": [
        "password spray",
        "brute[- ]?force",
        "multiple failed (logon|login|sign-?in)",
        "credential stuffing"
      ]
    },
    {
      "alert_type": "MFA fatigue / push bombing",
      "domain": "Identity",
      "detector_ids": [],
      "title_patterns": [
        "mfa (fatigue|bomb|spam)",
        "push bomb",
        "repeated mfa",
        "suspicious mfa"
      ]
    },
    {
      "alert_type": "Legacy-auth sign-in",
      "domain": "Identity",
      "detector_ids": [],
      "title_patterns": [
        "legacy auth",
        "basic auth"
      ]
    },
    {
      "alert_type": "OAuth app consent / token-session theft",
      "domain": "Identity",
      "detector_ids": [],
      "title_patterns": [
        "oauth",
        "app(lication)? consent",
        "consent grant",
        "token (theft|replay|stolen)",
