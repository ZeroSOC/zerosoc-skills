{
  "source": "Microsoft Defender XDR (Graph security alerts)",
  "version": "2026-09-17",
  "description": "Alert titles of the source mapped to the framework's alert types. A detector id match wins over any title match; then the first rule, in order, with a matching title pattern: rules are ordered from the specific to the general (email before endpoint malware, exfiltration before script execution). Detector ids are tenant-observable identifiers: none ship here, add them under detector_ids as they are seen, they make the mapping exact where a title is ambiguous or localized. A title that says nothing about the behaviour stays unmapped on purpose: scripts/alert_types.py reports it.",
  "rules": [
    {
      "alert_type": "User-reported phishing",
      "domain": "Email",
      "detector_ids": [],
      "title_patterns": [
        "reported by user",
        "user[- ]reported"
      ]
    },
    {
      "alert_type": "Inbox forwarding / redirect or hide rule",
      "domain": "Email",
      "detector_ids": [],
      "title_patterns": [
        "inbox (forwarding|manipulation|rule)",
        "(forwarding|redirect)(/redirect)? rule",
        "new-inboxrule",
        "suspicious email forwarding",
        "mail(box)? (redirect|forward)"
      ]
    },
    {
      "alert_type": "BEC impersonation / display-name spoof",
      "domain": "Email",
      "detector_ids": [],
      "title_patterns": [
        "(user|domain|brand|sender|mailbox) impersonation",
        "impersonation (of|attempt)",
        "display[- ]name spoof",
        "business email compromise|\\bbec\\b"
      ]
    },
    {
      "alert_type": "Malicious attachment / URL delivered",
      "domain": "Email",
      "detector_ids": [],
      "title_patterns": [
        "malicious (url|attachment)",
        "(malware|malicious file|phish).*(e-?mail|mail message|attachment)",
        "e-?mail messages? containing",
        "potentially malicious url click",
        "removed after delivery",
        "phish(ing)? (url|campaign|delivered)"
      ]
    },
    {
      "alert_type": "Ransomware mass-encryption",
      "domain": "Endpoint",
      "detector_ids": [],
      "title_patterns": [
        "ransomware behaviou?r",
        "ransomware activity",
        "files? (was|were) encrypted",
        "mass (file )?encryption"
      ]
    },
    {
      "alert_type": "Mass file destruction / disk wipe",
      "domain": "Endpoint",
      "detector_ids": [],
      "title_patterns": [
        "shadow cop(y|ies)",
        "vssadmin",
        "(file )?backups? (were|was) deleted",
        "inhibit system recovery",
        "disk wip",
        "mass file delet"
      ]
    },
    {
      "alert_type": "Credential dumping",
      "domain": "Endpoint",
      "detector_ids": [],
      "title_patterns": [
        "credential dump",
        "credential memory read",
        "lsass",
        "credential theft",
        "ntds",
        "sam (database|registry) .*(dump|access)",
        "mimikatz"
      ]
    },
    {
      "alert_type": "Security-tool / AMSI tampering",
      "domain": "Endpoint",
      "detector_ids": [],
      "title_patterns": [
        "tamper",
        "attempt to turn off .*(antivirus|protection)",
        "\\bamsi\\b",
        "(antivirus|real-time protection|security (tool|software)) .*(disabled|turned off|stopped)",
        "(event|security) log was cleared"
      ]
    },
    {
      "alert_type": "Persistence mechanism created",
      "domain": "Endpoint",
      "detector_ids": [],
      "title_patterns": [
        "scheduled task",
        "suspicious service (registration|registered|creat|install)",
        "(registry )?run key",
        "autostart",
        "anomaly detected in asep",
        "persistence"
      ]
    },
    {
      "alert_type": "Outbound data spike",
      "domain": "Network",
      "detector_ids": [],
      "title_patterns": [
        "exfiltrat",
        "unusual (outbound|upload|data transfer)",
        "data (upload|transfer) (to|volume)"
      ]
    },
    {
      "alert_type": "C2 beaconing / known-bad destination",
      "domain": "Network",
      "detector_ids": [],
      "title_patterns": [
        "command[- ]and[- ]control|\\bc2\\b",
        "beacon",
        "connection to (a |an )?(malicious|known[- ]bad|suspicious) (domain|ip|url|destination)",
        "network connection to a malicious"
      ]
    },
    {
      "alert_type": "Suspicious script / interpreter execution",
      "domain": "Endpoint",
      "detector_ids": [],
      "title_patterns": [
        "powershell",
        "suspicious (script|command ?line|wscript|cscript|mshta|rundll32|regsvr32)",
        "living[- ]off[- ]the[- ]land",
        "encoded command",
        "remote (shell|command|powershell)",
        "suspicious remote activity"
      ]
    },
    {
      "alert_type": "Trusted software / updater anomalous behaviour",
      "domain": "Endpoint",
      "detector_ids": [],
      "title_patterns": [
        "dll (side|search)[- ]?(load|order)",
        "signed (binary|executable).*(unusual|suspicious)",
        "updater .*(anomal|suspicious)"
      ]
    },
    {
      "alert_type": "Ingress tool transfer to host",
      "domain": "Endpoint",
      "detector_ids": [],
      "title_patterns": [
        "tool transfer",
        "(hack|attack) ?tool .*(download|drop|written)",
        "suspicious (file )?download",
        "certutil"
      ]
    },
    {
      "alert_type": "Malware / loader execution",
      "domain": "Endpoint",
      "detector_ids": [],
      "title_patterns": [
        "(malware|ransomware) (was )?(detected|prevented|blocked|found)",
        "an active .* (malware|hacktool|backdoor|trojan)",
        "malicious file",
        "trojan",
        "backdoor",
        "hacktool",
        "\\bloader\\b",
        "suspicious (file|binary|executable|process)",
        "process injection",
        "unwanted software"
      ]
    },
    {
      "alert_type": "Impossible-travel / anomalous sign-in",
      "domain": "Identity",
      "detector_ids": [],
      "title_patterns": [
        "impossible travel",
        "atypical travel",
        "unfamiliar sign-?in",
        "anonymous ip",
        "anomalous (sign-?in|token)",
        "(sign-?in|activity) from (a |an )?(malicious|suspicious|infrequent) (ip|country)",
        "risky sign-?in"
      ]
    },
    {
      "alert_type": "Brute force / password spray",
      "domain": "Identity",
      "detector_ids": [],
      "title_patterns": [
        "password spray",
        "brute[- ]?force",
        "multiple failed (logon|login|sign-?in)",
        "credential stuffing"
      ]
    },
    {
      "alert_type": "MFA fatigue / push bombing",
      "domain": "Identity",
      "detector_ids": [],
      "title_patterns": [
        "mfa (fatigue|bomb|spam)",
        "push bomb",
        "repeated mfa",
        "suspicious mfa"
      ]
    },
    {
      "alert_type": "Legacy-auth sign-in",
      "domain": "Identity",
      "detector_ids": [],
      "title_patterns": [
        "legacy auth",
        "basic auth"
      ]
    },
    {
      "alert_type": "OAuth app consent / token-session theft",
      "domain": "Identity",
      "detector_ids": [],
      "title_patterns": [
        "oauth",
        "app(lication)? consent",
        "consent grant",
        "token (theft|replay|stolen)",
