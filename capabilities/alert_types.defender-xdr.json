        "role assignment",
        "elevation of privilege"
      ]
    },
    {
      "alert_type": "User-reported phishing",
      "domain": "Email",
      "detector_ids": [],
      "title_patterns": [
        "reported by user",
        "user[- ]reported"
      ]
    },
    {
      "alert_type": "Inbox forwarding / redirect or hide rule",
      "domain": "Email",
      "detector_ids": [],
      "title_patterns": [
        "inbox (forwarding|manipulation|rule)",
        "forwarding rule",
        "new-inboxrule",
        "suspicious email forwarding",
        "mail(box)? (redirect|forward)"
      ]
    },
    {
      "alert_type": "BEC impersonation / display-name spoof",
      "domain": "Email",
      "detector_ids": [],
      "title_patterns": [
        "impersonat",
        "display[- ]name spoof",
        "business email compromise|\\bbec\\b"
      ]
    },
    {
      "alert_type": "Malicious attachment / URL delivered",
      "domain": "Email",
      "detector_ids": [],
      "title_patterns": [
        "malicious (url|file|attachment)",
        "(phish|malware) (url|campaign|email|message)",
        "email messages? containing",
        "potentially malicious url click",
        "removed after delivery",
        "phish(ing)? delivered"
      ]
    },
    {
      "alert_type": "C2 beaconing / known-bad destination",
      "domain": "Network",
      "detector_ids": [],
      "title_patterns": [
        "command[- ]and[- ]control|\\bc2\\b",
        "beacon",
        "connection to (a )?(malicious|known[- ]bad|suspicious) (domain|ip|url|destination)",
        "network connection to a malicious"
      ]
    },
    {
      "alert_type": "Internal scan / lateral movement",
      "domain": "Network",
      "detector_ids": [],
      "title_patterns": [
        "lateral movement",
        "(network|port|internal) scan",
        "network (service )?discovery",
        "remote service",
        "pass[- ]the[- ](hash|ticket)",
        "smb .*(enumeration|scan)",
        "anomalous account lookups"
      ]
    },
    {
      "alert_type": "DNS tunneling / suspicious DNS",
      "domain": "Network",
      "detector_ids": [],
      "title_patterns": [
        "dns tunnel",
        "suspicious dns"
      ]
    },
    {
      "alert_type": "Outbound data spike",
      "domain": "Network",
      "detector_ids": [],
      "title_patterns": [
        "exfiltrat",
        "unusual (outbound|upload|data transfer)",
        "data (upload|transfer) (to|volume)"
      ]
    },
    {
      "alert_type": "Unsanctioned SaaS app usage (Shadow IT / Shadow AI discovery)",
      "domain": "Cloud",
      "detector_ids": [],
      "title_patterns": [
        "unsanctioned (app|saas)",
        "shadow (it|ai)",
        "discovered app"
      ]
    },
    {
      "alert_type": "DLP violation (regulated data)",
      "domain": "Data",
      "detector_ids": [],
      "title_patterns": [
        "\\bdlp\\b",
        "data loss prevention",
        "sensitive (info|data).*(shared|sent|upload)"
      ]
    },
    {
      "alert_type": "Mass sensitive-file access by one principal",
      "domain": "Data",
      "detector_ids": [],
      "title_patterns": [
        "mass (download|file access|access)",
        "unusual (volume of )?file (access|download)",
        "mass delet"
      ]
    },
    {
      "alert_type": "Ransom-note file dropped",
      "domain": "Data",
      "detector_ids": [],
      "title_patterns": [
        "ransom[- ]?note"
      ]
    },
    {
      "alert_type": "Web shell upload",
      "domain": "Application",
      "detector_ids": [],
      "title_patterns": [
        "web ?shell"
      ]
    }
  ]
}
