        "role assignment",
        "elevation of privilege"
      ]
    },
    {
      "alert_type": "Internal scan / lateral movement",
      "domain": "Network",
      "detector_ids": [],
      "title_patterns": [
        "lateral movement",
        "(network|port|internal) scan",
        "network (service )?discovery",
        "pass[- ]the[- ](hash|ticket)",
        "smb .*(enumeration|scan)",
        "anomalous account lookups"
      ]
    },
    {
      "alert_type": "DNS tunneling / suspicious DNS",
      "domain": "Network",
      "detector_ids": [],
      "title_patterns": [
        "dns tunnel",
        "suspicious dns"
      ]
    },
    {
      "alert_type": "Unsanctioned SaaS app usage (Shadow IT / Shadow AI discovery)",
      "domain": "Cloud",
      "detector_ids": [],
      "title_patterns": [
        "unsanctioned (app|saas)",
        "shadow (it|ai)",
        "discovered app"
      ]
    },
    {
      "alert_type": "DLP violation (regulated data)",
      "domain": "Data",
      "detector_ids": [],
      "title_patterns": [
        "\\bdlp\\b",
        "data loss prevention",
        "sensitive (info|data).*(shared|sent|upload)"
      ]
    },
    {
      "alert_type": "Mass sensitive-file access by one principal",
      "domain": "Data",
      "detector_ids": [],
      "title_patterns": [
        "mass (download|file access)",
        "unusual (volume of )?file (access|download)"
      ]
    },
    {
      "alert_type": "Ransom-note file dropped",
      "domain": "Data",
      "detector_ids": [],
      "title_patterns": [
        "ransom[- ]?note"
      ]
    },
    {
      "alert_type": "Web shell upload",
      "domain": "Application",
      "detector_ids": [],
      "title_patterns": [
        "web ?shell"
      ]
    }
  ],
  "fields": {
    "detector_id": "detectorId"
  },
  "detection_metadata": {
    "description": "Where each assertion of Detection & Analysis §1.1 lives in this source's records, read by scripts/alert_metadata.py. \"fields\" names them on the alert, \"entity_fields\" on an evidence item, whose canonical names are the ones scripts/evidence_inventory.py prints (a row that already carries remediation_status needs no alias). The analytic types are the OCSF analytic type and type_id a detection source maps onto; a source not listed here is Other (99). The remediation states say what the source did and whether it completed; a state not listed here is recorded as reported and is never treated as neutralized.",
    "fields": {
      "techniques": "mitreTechniques",
      "threat_name": "threatDisplayName",
      "threat_family": "threatFamilyName",
      "detection_source": "detectionSource",
      "detector_id": "detectorId",
      "description": "description",
      "recommended_actions": "recommendedActions"
    },
    "entity_fields": {
      "remediation_status": "remediationStatus",
      "remediation_status_details": "remediationStatusDetails"
    },
