  "case_map": [
    {
      "path": "id",
      "case": "uid"
    },
    {
      "path": "displayName",
      "ignored": "the source's title for the incident; the Case's account is its Notes, and a title nobody wrote is not one"
    },
    {
      "path": "severity",
      "case": "severity_id"
    },
    {
      "path": "status",
      "case": "status_id"
    },
    {
      "path": "createdDateTime",
      "ignored": "when the source opened its record. The Case's start_time is when the adversary acted, which is the earliest alert activity, and its own lifecycle is in its events"
    },
    {
      "path": "lastUpdateDateTime",
      "case": "microsoft.last_update_time"
    },
    {
      "path": "tenantId",
      "case": "microsoft.tenant_id"
    },
    {
      "path": "incidentWebUrl",
      "case": "microsoft.incident_web_url"
    },
    {
      "path": "classification",
      "case": "microsoft.classification"
    },
    {
      "path": "determination",
      "case": "microsoft.determination"
    },
    {
      "path": "assignedTo",
      "case": "microsoft.assigned_to"
    },
    {
      "path": "redirectIncidentId",
      "case": "zerosoc.master_case_uid"
    },
    {
      "path": "comments",
      "ignored": "the analyst thread on the source's record. The engine reads it to see whether its own write-back is already there, and a comment is not Case data: the Case's account is its Notes"
    },
    {
      "path": "customTags",
      "ignored": "the operator's own tags on the source's record. Nothing in the framework reads them, and a deployment that wants them says so here rather than having them appear on a Case unexamined"
    },
    {
      "path": "systemTags",
      "ignored": "the source's own tags on the incident. Same: read by nothing, and recorded here so that a tag the vendor starts sending is not silence"
    },
    {
      "path": "@odata.context",
      "ignored": "the API's own envelope, not the record"
    },
    {
      "path": "alerts",
      "case": "finding_info_list[]"
    },
    {
      "path": "alerts[].id",
      "case": "finding_info_list[].uid"
    },
    {
      "path": "alerts[].title",
      "case": "finding_info_list[].title"
    },
    {
      "path": "alerts[].description",
      "case": "finding_info_list[].desc"
    },
    {
      "path": "alerts[].severity",
      "case": "finding_info_list[].severity_id"
    },
    {
      "path": "alerts[].mitreTechniques",
      "case": "finding_info_list[].attacks[].technique.uid"
    },
    {
      "path": "alerts[].detectionSource",
      "case": "finding_info_list[].analytic.type"
    },
    {
      "path": "alerts[].detectorId",
      "case": "finding_info_list[].analytic.uid"
    },
    {
      "path": "alerts[].threatDisplayName",
      "case": "finding_info_list[].traits[].values[]"
    },
    {
      "path": "alerts[].threatFamilyName",
      "case": "finding_info_list[].traits[].name"
    },
    {
      "path": "alerts[].recommendedActions",
      "case": "finding_info_list[].desc",
      "note": "the source's own procedure. It reaches the Case as the disposition of each recommendation — the Finding a followed one produced, or the Finding that states why it was set aside — never as a block of text on the alert"
    },
    {
      "path": "alerts[].firstActivityDateTime",
      "case": "finding_info_list[].first_seen_time"
    },
    {
      "path": "alerts[].lastActivityDateTime",
      "case": "finding_info_list[].last_seen_time"
    },
    {
      "path": "alerts[].createdDateTime",
      "case": "finding_info_list[].created_time"
    },
    {
      "path": "alerts[].productName",
      "case": "zerosoc.provenance.products[].name"
    },
    {
      "path": "alerts[].serviceSource",
      "ignored": "which Defender workload raised the alert. detectionSource is the finer of the two and is what the analytic carries; this one is kept out rather than recorded twice"
    },
    {
      "path": "alerts[].providerAlertId",
      "ignored": "the workload's own id for the alert, before Defender gave it one. The Case cites the alert by the id Defender publishes, which is what a reader can open"
    },
    {
      "path": "alerts[].incidentId",
      "ignored": "the alert's back-reference to the incident: the Case is that incident, so the link is the Case's own uid"
    },
    {
      "path": "alerts[].tenantId",
      "ignored": "the tenant, already on the Case once from the incident; an alert of another tenant is refused at intake"
    },
    {
      "path": "alerts[].category",
      "ignored": "the source's own kill-chain category. The framework's alert type comes from the alert_types rules of this profile and its Incident Category from the playbook, neither of which reads this"
    },
    {
      "path": "alerts[].status",
      "ignored": "the source's per-alert triage state. The Case has one status, and it is the executor's"
    },
    {
      "path": "alerts[].classification",
      "ignored": "the source's per-alert verdict. The Case's verdict is the engine's own, and the source's sits on the incident's extension where it is visible without being weighed"
    },
    {
      "path": "alerts[].determination",
      "ignored": "as classification: the source's per-alert determination"
    },
    {
      "path": "alerts[].evidence",
      "case": "observables[]"
    },
    {
      "path": "alerts[].evidence[].@odata.type",
      "ignored": "the entity's kind, as the API types it. It selects which of the fields below are read and becomes the observable's type_id rather than a value of its own"
    },
    {
      "path": "alerts[].evidence[].verdict",
      "ignored": "the source's per-entity verdict. Read by the evidence inventory to show what the source thought; it is not a Finding of the Case, which weighs the evidence itself"
    },
    {
      "path": "alerts[].evidence[].remediationStatus",
      "case": "finding_info_list[].types[]"
    },
    {
      "path": "alerts[].evidence[].remediationStatusDetails",
      "case": "finding_info_list[].desc"
    },
    {
      "path": "alerts[].evidence[].mdeDeviceId",
      "case": "observables[].value"
    },
    {
      "path": "alerts[].evidence[].deviceDnsName",
      "case": "observables[].value"
    },
    {
      "path": "alerts[].evidence[].osPlatform",
      "ignored": "the device's platform. Asset context the enrichment asks the source for at triage, where it is a Finding with its analytic, rather than an unattributed field on the Case"
    },
    {
      "path": "alerts[].evidence[].ipAddress",
      "case": "observables[].value"
    },
    {
      "path": "alerts[].evidence[].countryLetterCode",
      "ignored": "where the source geolocated the address. Geolocation is enrichment and reaches the Case as a Finding with what produced it"
    },
    {
      "path": "alerts[].evidence[].userAccount",
      "case": "observables[].value"
    },
    {
      "path": "alerts[].evidence[].userAccount.userPrincipalName",
      "case": "observables[].value"
    },
    {
      "path": "alerts[].evidence[].userAccount.accountName",
      "case": "observables[].value"
    },
    {
      "path": "alerts[].evidence[].userAccount.azureAdUserId",
      "case": "observables[].value"
    },
    {
      "path": "alerts[].evidence[].userAccount.domainName",
      "ignored": "the account's domain, already in the principal name the observable carries"
    },
    {
      "path": "alerts[].evidence[].fileDetails",
      "case": "observables[].value"
    },
    {
      "path": "alerts[].evidence[].fileDetails.sha256",
      "case": "observables[].value"
    },
    {
      "path": "alerts[].evidence[].fileDetails.fileName",
      "case": "observables[].name"
    },
    {
      "path": "alerts[].evidence[].fileDetails.filePath",
      "ignored": "where the file was. It travels with the evidence row the inventory builds and with the evidence a Finding rests on; the observable is the hash, which is what a lookup takes"
    },
    {
      "path": "alerts[].evidence[].fileDetails.signer",
      "ignored": "the signature's subject. The signed-publisher check reads it from the evidence row and states it as a Finding, with the check that produced it"
    },
    {
      "path": "alerts[].evidence[].fileDetails.issuer",
      "ignored": "as signer: read by the signed-publisher check, not carried unattributed"
    },
    {
      "path": "alerts[].evidence[].processCommandLine",
      "ignored": "the command line. Evidence a Finding rests on, kept where that Finding cites it, and never an observable: an observable is an entity that can be looked up"
    },
    {
      "path": "alerts[].evidence[].processId",
      "ignored": "the process id, meaningful only with the device and the creation time. The evidence row carries the three together"
    },
    {
      "path": "alerts[].evidence[].processCreationDateTime",
      "ignored": "with processId and the device, the identity of one process instance; on the evidence row, not on the Case as a field"
    },
    {
      "path": "alerts[].evidence[].imageFile",
      "case": "observables[].value"
    },
    {
      "path": "alerts[].evidence[].imageFile.sha256",
      "case": "observables[].value"
    },
    {
      "path": "alerts[].evidence[].imageFile.fileName",
      "case": "observables[].name"
    },
    {
      "path": "alerts[].evidence[].imageFile.filePath",
      "ignored": "the image's path: with the evidence row, as fileDetails.filePath"
    },
    {
      "path": "alerts[].evidence[].parentProcessId",
      "ignored": "the parent, which the attack graph reads from the evidence rows; on the Case it is an edge, not a field"
    },
    {
      "path": "alerts[].evidence[].parentProcessCreationDateTime",
      "ignored": "with parentProcessId, the parent instance; on the evidence row"
    },
    {
      "path": "alerts[].evidence[].parentProcessImageFile",
      "ignored": "the parent's image, read with the parent instance on the evidence row"
    },
    {
      "path": "alerts[].evidence[].parentProcessImageFile.fileName",
      "ignored": "as parentProcessImageFile"
    },
    {
      "path": "alerts[].evidence[].parentProcessImageFile.filePath",
      "ignored": "as parentProcessImageFile"
    }
  ],
  "extension": {
    "key": "microsoft",
    "description": "What this source states about the incident and the framework has no field for. Nothing the framework carries is repeated here: that would be a mapping, not an extension.",
    "properties": {
      "incident_id": {
        "type": "string",
        "from": "id",
        "description": "The source's identifier, which is also the Case's uid; kept so the extension reads whole on its own."
      },
      "incident_web_url": {
        "type": "string",
        "from": "incidentWebUrl",
        "description": "Where an analyst opens the incident in the source's portal."
      },
      "tenant_id": {
        "type": "string",
        "from": "tenantId",
        "description": "The tenant the incident belongs to; an incident of another tenant is refused at intake."
      },
      "status": {
        "type": "string",
        "from": "status",
        "description": "The source's own status, in its own word."
      },
      "classification": {
        "type": "string",
        "from": "classification",
        "description": "The source's own verdict, recorded and never weighed: the Case's verdict is the executor's."
      },
      "determination": {
        "type": "string",
        "from": "determination",
        "description": "The source's own determination, on the same terms."
      },
      "assigned_to": {
        "type": "string",
        "from": "assignedTo",
        "description": "Who owns the incident in the source; the Case's assignee is the executor's own."
      },
      "redirect_incident_id": {
        "type": "string",
        "from": "redirectIncidentId",
        "description": "The master this incident was merged into."
      },
      "last_update_time": {
        "type": "integer",
        "from": "lastUpdateDateTime",
        "description": "When the source last changed the record; the poller resumes from it."
      }
    }
  },
  "capability_coverage": {
    "capabilities": {
      "asset.cmdb": {
        "answers": "What is this device: its platform, its risk and exposure, its tags and the value the operator gave it.",
        "limits": [
          "a device the endpoint sensor never onboarded is not here"
        ],
        "operation": "get_machine"
      },
      "identity.directory": {
        "answers": "What this source knows about an account: the alerts it appears in and the devices it has used.",
        "limits": [
          "this source has no directory record of its own: the account's attributes come from the directory itself, not from here",
          "an account outside the directory — a local account, a guest that never signed in — appears only where an alert named it"
        ],
        "operation": "get_user_alerts"
      },
      "malware.repository": {
        "answers": "What the vendor knows about a file: its own verdict, its signer, and how widely it has been seen.",
        "limits": [
          "a hash the vendor has never seen returns no record, which is an answer and not a gap",
          "prevalence is this tenant's and the vendor's, not the world's"
        ],
        "operation": "get_file_info"
      },
      "reputation.multi_engine": {
        "answers": "What this source has seen of an address or a domain: the alerts it appears in and its prevalence here.",
        "limits": [
          "this is one vendor's sight of the indicator, not a multi-engine consensus: the class is named for what the method wants, and this source answers the narrower question",
          "an address the tenant has never contacted has no statistics, which is not a verdict"
        ],
        "operation": "get_ip_statistics"
      },
      "cases.store": {
        "answers": "Has this entity been in an incident before, and how were those incidents determined.",
        "limits": [
          "the source's own incident history only, bounded by its retention"
        ],
        "operation": "list_incidents"
      },
      "telemetry.endpoint": {
        "answers": "What ran, what was written, what connected, on a device.",
        "limits": [
          "advanced hunting is not available on every licence tier",
          "the hunting tables are retained for 30 days"
        ],
        "operation": "run_hunting_query"
      },
      "telemetry.identity": {
        "answers": "Sign-ins and directory changes for an account.",
        "limits": [
          "identity tables are empty where the identity workload is not deployed"
        ],
        "operation": "run_hunting_query"
      }
    },
    "data_sources": {
      "EDR / endpoint process telemetry": true,
      "Endpoint file-system telemetry": true,
      "Network connection telemetry": true,
      "Identity / sign-in logs": true,
      "Email / collaboration telemetry": true
    }
  },
  "queries": {
    "process_events": {
      "asks": "What ran on this device, in this window?",
      "table": "DeviceProcessEvents",
      "recipe": "DeviceProcessEvents | where DeviceId =~ '{device}' or DeviceName =~ '{device}' | limit {limit}",
      "limits": [
        "30-day retention",
        "advanced hunting is not on every licence tier"
      ]
    },
    "file_events": {
      "asks": "What was written, renamed or deleted on this device?",
      "table": "DeviceFileEvents",
      "recipe": "DeviceFileEvents | where DeviceId =~ '{device}' or SHA256 =~ '{hash}' | limit {limit}",
      "limits": [
        "30-day retention"
      ]
    },
    "network_events": {
      "asks": "What did this device connect to?",
      "table": "DeviceNetworkEvents",
      "recipe": "DeviceNetworkEvents | where RemoteIP =~ '{ip}' or LocalIP =~ '{ip}' | limit {limit}",
      "limits": [
        "30-day retention"
      ]
    },
    "logon_events": {
      "asks": "Who logged on to this device, and how?",
      "table": "DeviceLogonEvents",
      "recipe": "DeviceLogonEvents | where DeviceId =~ '{device}' or AccountUpn =~ '{user}' | limit {limit}",
      "limits": [
        "30-day retention"
      ]
    },
    "registry_events": {
      "asks": "What was written to the registry on this device?",
      "table": "DeviceRegistryEvents",
      "recipe": "DeviceRegistryEvents | where DeviceId =~ '{device}' | limit {limit}",
      "limits": [
        "30-day retention"
      ]
    },
    "sign_ins": {
      "asks": "Where did this account sign in from?",
      "table": "AADSignInEventsBeta",
      "recipe": "AADSignInEventsBeta | where AccountUpn =~ '{user}' | limit {limit}",
      "limits": [
        "the table is in preview and absent on lower tiers",
        "sign-in retention is shorter than the endpoint tables on some licences"
      ]
    },
    "email_messages": {
      "asks": "What did this message do, and who else received it?",
      "table": "EmailEvents",
      "recipe": "EmailEvents | where SenderFromAddress =~ '{sender}' or NetworkMessageId =~ '{id}' | limit {limit}",
      "limits": [
        "needs the collaboration workload"
      ]
    },
    "related_cases": {
      "asks": "Has this entity been in an incident before?",
      "recipe": "list_incidents(filter: lastUpdateDateTime ge {since})",
      "limits": [
        "the source's own incidents only"
      ]
    },
    "directory_changes": {
      "asks": "What changed on this account or group, and who changed it?",
      "table": "IdentityDirectoryEvents",
      "recipe": "IdentityDirectoryEvents | where AccountUpn =~ '{user}' or TargetAccountUpn =~ '{user}' | limit {limit}",
      "limits": [
        "needs the identity workload deployed against the domain controllers"
      ]
    }
  }
}
